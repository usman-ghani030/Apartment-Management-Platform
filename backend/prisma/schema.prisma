datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  COMMITTEE_ADMIN
  RESIDENT
  SECURITY_GUARD
  VENDOR
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum UnitType {
  OWNER_OCCUPIED
  RENTED
  VACANT
}

enum BedroomType {
  STUDIO
  ONE_BED
  TWO_BED
  THREE_BED
  FOUR_BED
  FOUR_PLUS_BED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PollStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ResultsVisibility {
  LIVE
  AFTER_CLOSE
  NEVER
}

enum VisitorPassStatus {
  PENDING
  APPROVED
  CHECKED_IN
  CHECKED_OUT
  EXPIRED
  CANCELLED
}

enum GateLogAction {
  ENTRY
  EXIT
}

model VisitorPass {
  id             String            @id @default(uuid())
  societyId      String
  society        Society           @relation(fields: [societyId], references: [id])
  unitId         String
  unit           Unit              @relation(fields: [unitId], references: [id])
  residentId     String
  resident       User              @relation(fields: [residentId], references: [id])
  visitorName    String
  visitorPhone   String
  visitorEmail   String?
  vehicleNumber  String?
  purpose        String?
  expectedArrival DateTime?
  expectedDeparture DateTime?
  status         VisitorPassStatus @default(PENDING)
  qrToken        String            @unique
  approvedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  gateLogs GateLog[]

  @@index([societyId])
  @@index([societyId, status])
  @@index([unitId])
  @@index([qrToken])
}

model GateLog {
  id            String        @id @default(uuid())
  societyId     String
  society       Society       @relation(fields: [societyId], references: [id])
  visitorPassId String
  visitorPass   VisitorPass   @relation(fields: [visitorPassId], references: [id])
  unitId        String?
  unit          Unit?         @relation(fields: [unitId], references: [id])
  action        GateLogAction
  guardId       String?
  guard         User?         @relation(fields: [guardId], references: [id])
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([societyId, createdAt])
  @@index([visitorPassId])
}

model Poll {
  id                String             @id @default(uuid())
  societyId         String
  society           Society            @relation(fields: [societyId], references: [id])
  title             String
  description       String?
  options           Json               // Array of { label: string, description?: string }
  createdBy         String
  noticeId          String?
  startsAt          DateTime
  endsAt            DateTime
  resultsVisibility ResultsVisibility  @default(AFTER_CLOSE)
  status            PollStatus         @default(DRAFT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  votes Vote[]

  @@index([societyId])
  @@index([societyId, status])
}

model Vote {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id])
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id])
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  optionIndex Int    // Index into the poll's options array
  votedAt   DateTime @default(now())

  @@unique([pollId, unitId]) // One vote per unit per poll
  @@index([pollId])
  @@index([pollId, unitId])
  @@index([societyId])
}

model DocumentFolder {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id])
  name      String
  parentId  String?
  parent    DocumentFolder? @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  DocumentFolder[] @relation("FolderHierarchy")
  documents Document[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([societyId])
}

model Document {
  id          String   @id @default(uuid())
  societyId   String
  society     Society  @relation(fields: [societyId], references: [id])
  folderId    String?
  folder      DocumentFolder? @relation(fields: [folderId], references: [id])
  name        String
  description String?
  fileUrl     String
  fileSize    Int
  mimeType    String
  uploadedBy  String
  uploader    User     @relation(fields: [uploadedBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([societyId])
  @@index([folderId])
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Society {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  // Phase 7: how many days before the due date to send the automated dues reminder
  dueReminderDays Int      @default(3)
  // Phase 8: day-of-month for recurring billing cycle (1-28, null = disabled)
  billingDayOfMonth Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildings    Building[]
  units        Unit[]
  memberships  Membership[]
  notices      Notice[]
  tickets      Ticket[]
  invoices     Invoice[]
  payments     Payment[]
  amenities    Amenity[]
  bookings     Booking[]
  visitorPasses VisitorPass[]
  gateLogs     GateLog[]
  polls        Poll[]
  votes        Vote[]
  documentFolders DocumentFolder[]
  documents       Document[]
  parcels      Parcel[]
  staff        Staff[]
  sosAlerts    SOSAlert[]
  invoiceReminders InvoiceReminder[]
  // Phase 9: societies paying the PLATFORM — entirely separate from resident dues (Invoice)
  platformInvoices     PlatformInvoice[]
  platformCustomQuoteFlags PlatformCustomQuoteFlag[]
  auditLogs    AuditLog[]
}

model Building {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  units Unit[]

  @@index([societyId])
}

model Unit {
  id         String    @id @default(uuid())
  societyId  String
  society    Society   @relation(fields: [societyId], references: [id])
  buildingId String
  building   Building  @relation(fields: [buildingId], references: [id])
  unitNumber String
  floor      Int
  type       UnitType
  // Flat category for bedroom configuration
  bedroomType BedroomType?
  // Primary contact info (fallback when no resident account linked)
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? // Soft delete support

  memberships  Membership[]
  tickets      Ticket[]
  invoices     Invoice[]
  bookings     Booking[]
  visitorPasses VisitorPass[]
  gateLogs      GateLog[]
  votes         Vote[]
  parcels      Parcel[]
  sosAlerts    SOSAlert[]

  @@index([societyId])
  @@index([buildingId])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  // Nullable for Google-only accounts (never set a password)
  passwordHash String?
  // Google Sign-In: the Google account ID (`sub`) once linked to this user
  googleId     String?   @unique
  // Set to true when Google has verified the email ownership
  emailVerified Boolean  @default(false)
  // Bumped on password reset to invalidate every outstanding refresh token
  // (refresh JWTs carry the version they were signed at — see ADR 001 flow)
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  passwordResetTokens PasswordResetToken[]

  memberships  Membership[]
  notices      Notice[]
  readReceipts NoticeReadReceipt[]
  tickets      Ticket[]
  ticketsRated Ticket[] @relation("TicketRatedBy")
  ticketComments TicketComment[]
  platformInvoicesMarkedPaid PlatformInvoice[] @relation("PlatformInvoiceMarkedPaidBy")
  bookings      Booking[]
  visitorPasses VisitorPass[]
  gateLogs      GateLog[]
  votes         Vote[]
  documents     Document[]
  parcelsLoggedBy   Parcel[] @relation("ParcelLoggedBy")
  parcelsCollected  Parcel[] @relation("ParcelCollectedBy")
  sosAlertsTriggered SOSAlert[] @relation("SOSAlertTriggeredBy")
  sosAlertsResolved  SOSAlert[] @relation("SOSAlertResolvedBy")
}

model Amenity {
  id          String   @id @default(uuid())
  societyId   String
  society     Society  @relation(fields: [societyId], references: [id])
  name        String
  description String?
  maxDuration Int      @default(120)    // Max booking duration in minutes
  advanceNotice Int    @default(24)     // Hours of advance notice required
  maxPerUnit  Int      @default(2)      // Max bookings per unit per day
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  bookings    Booking[]

  @@index([societyId])
}

model Booking {
  id         String        @id @default(uuid())
  societyId  String
  society    Society       @relation(fields: [societyId], references: [id])
  amenityId  String
  amenity    Amenity       @relation(fields: [amenityId], references: [id])
  unitId     String
  unit       Unit          @relation(fields: [unitId], references: [id])
  residentId String
  resident   User          @relation(fields: [residentId], references: [id])
  startTime  DateTime
  endTime    DateTime
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([societyId, amenityId, startTime])
  @@index([societyId, unitId])
  @@index([amenityId, startTime, status])
}

model Membership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  societyId String
  society   Society          @relation(fields: [societyId], references: [id])
  unitId    String?
  unit      Unit?            @relation(fields: [unitId], references: [id])
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime? // Soft delete support

  @@index([societyId])
  @@index([userId])
  @@index([unitId])
}

model Invoice {
  id            String        @id @default(uuid())
  societyId     String
  society       Society       @relation(fields: [societyId], references: [id])
  unitId        String
  unit          Unit          @relation(fields: [unitId], references: [id])
  invoiceNumber String        @unique
  title         String
  description   String?
  amount        Int           // Amount in paisa, the lowest denomination (avoid floating point)
  dueDate       DateTime
  status        InvoiceStatus @default(ISSUED)
  periodStart   DateTime?
  periodEnd     DateTime?
  // Phase 8: billing period marker for idempotent recurring billing (e.g. "2026-09")
  billingPeriod String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  payments Payment[]
  invoiceReminders InvoiceReminder[]

  @@unique([societyId, unitId, billingPeriod], name: "unique_billing_period")
  @@index([societyId, status])
  @@index([societyId, unitId])
  @@index([unitId])
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  societyId     String
  society       Society  @relation(fields: [societyId], references: [id])
  amount        Int
  currency      String   @default("pkr")
  // Payment gateway fields (Safepay hosted checkout)
  provider      String   @default("offline") // offline | safepay
  providerSessionId String? @unique // Safepay tracker token
  providerTxnRef    String? // Safepay transaction reference
  stripePaymentIntentId String? @unique
  stripeSessionId       String?
  status        String   @default("pending") // pending, succeeded, failed, refunded
  paidAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([invoiceId])
  @@index([societyId, createdAt])
}

model Notice {
  id          String    @id @default(uuid())
  societyId   String
  society     Society   @relation(fields: [societyId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  title       String
  content     String
  category    String    @default("general")
  // Phase 8: targeted notifications — which units should see this notice
  targetType  String    @default("ALL_UNITS") // ALL_UNITS | SPECIFIC_UNITS
  targetUnitIds Json?    // Array of unit IDs when targetType = SPECIFIC_UNITS
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  readReceipts NoticeReadReceipt[]

  @@index([societyId, publishedAt])
  @@index([societyId, createdAt])
}

model Ticket {
  id          String       @id @default(uuid())
  societyId   String
  society     Society      @relation(fields: [societyId], references: [id])
  unitId      String?
  unit        Unit?        @relation(fields: [unitId], references: [id])
  residentId  String
  resident    User         @relation(fields: [residentId], references: [id])
  title       String
  description String
  category    String       @default("other")
  status      TicketStatus @default(OPEN)
  assignedTo  String?       // Vendor name/contact placeholder
  photosUrl   String?       // Comma-separated URLs or JSON — Cloudinary integration deferred
  // Phase 7 vendor ratings: captured when the ticket transitions to CLOSED
  rating        Int?        // 1-5 stars
  ratingComment String?
  ratedById     String?
  ratedBy       User?       @relation("TicketRatedBy", fields: [ratedById], references: [id])
  ratedAt       DateTime?
  // Phase 7 analytics: set once when the ticket transitions to CLOSED (unlike
  // updatedAt, which also changes on re-rating) — enables accurate resolution time
  closedAt    DateTime?
  // Vendor magic-link access (no vendor accounts exist): the vendor's contact
  // email, plus the SHA-256 hash of their access token. The raw token is only
  // ever inside the emailed link — never stored. Overwritten on reassignment
  // (kills the previous vendor's link) and cleared when the ticket is CLOSED.
  vendorEmail              String?
  vendorAccessTokenHash    String?   @unique
  vendorAccessTokenIssuedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  comments TicketComment[]

  @@index([societyId, status])
  @@index([societyId, createdAt])
  @@index([residentId])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model NoticeReadReceipt {
  id       String   @id @default(uuid())
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  readAt   DateTime @default(now())

  @@unique([noticeId, userId])
}

enum StaffRole {
  GUARD
  CLEANER
  MAINTENANCE
  OTHER
}

enum SOSAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum SOSAlertCategory {
  MEDICAL
  FIRE
  SECURITY
  OTHER
}

enum ParcelStatus {
  ARRIVED
  COLLECTED
}

model Parcel {
  id              String       @id @default(uuid())
  societyId       String
  society         Society      @relation(fields: [societyId], references: [id])
  unitId          String
  unit            Unit         @relation(fields: [unitId], references: [id])
  loggedByUserId  String
  loggedByUser    User         @relation("ParcelLoggedBy", fields: [loggedByUserId], references: [id])
  collectedByUserId String?
  collectedByUser   User?      @relation("ParcelCollectedBy", fields: [collectedByUserId], references: [id])
  description     String
  photoUrl        String?
  status          ParcelStatus @default(ARRIVED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  @@index([societyId])
  @@index([societyId, status])
  @@index([unitId])
  @@index([societyId, createdAt])
}

// ── Automated Dues Reminders (Phase 7) ─────────────────────────────────────
// Records each automated reminder sent for an invoice. The unique pair
// (invoiceId, dueDate) means a reminder is sent at most once per due date;
// if the admin extends the due date, a fresh reminder can fire for the new date.
model InvoiceReminder {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id])
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  dueDate   DateTime // snapshot of the invoice due date this reminder targeted
  daysBefore Int     // how many days before the due date this reminder was sent
  sentAt    DateTime @default(now())

  @@unique([invoiceId, dueDate])
  @@index([societyId])
  @@index([invoiceId])
}

model Staff {
  id          String    @id @default(uuid())
  societyId   String
  society     Society   @relation(fields: [societyId], references: [id])
  name        String
  role        StaffRole
  email       String?
  phone       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([societyId])
  @@index([societyId, isActive])
}

model SOSAlert {
  id              String          @id @default(uuid())
  societyId       String
  society         Society         @relation(fields: [societyId], references: [id])
  unitId          String
  unit            Unit            @relation(fields: [unitId], references: [id])
  residentId      String
  resident        User            @relation("SOSAlertTriggeredBy", fields: [residentId], references: [id])
  category        SOSAlertCategory
  status          SOSAlertStatus  @default(ACTIVE)
  notes           String?
  resolvedByUserId String?
  resolvedBy      User?           @relation("SOSAlertResolvedBy", fields: [resolvedByUserId], references: [id])
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([societyId, status])
  @@index([societyId, createdAt])
  @@index([unitId])
}

// ── Password Reset (Phase 1 auth hardening) ────────────────────────────────
// Single-use, time-limited reset tokens. Only the SHA-256 hash of the raw
// token is stored — the raw token travels in the email link and is never
// persisted, so a DB leak cannot be replayed. `usedAt` enforces single-use
// atomically with the password update; `expiresAt` enforces the TTL.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique // sha256(rawToken) hex — never the raw token
  expiresAt DateTime
  usedAt    DateTime? // null = unused; set inside the reset transaction
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  societyId   String
  society     Society  @relation(fields: [societyId], references: [id])
  actorUserId String? // Nullable for system actions or initial onboarding
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  // Indexing baseline (Section 9 of PLAN.md): high traffic tables index by societyId and createdAt
  @@index([societyId, createdAt])
}

// ── Platform Billing (Phase 9, ADR 006) ────────────────────────────────────
// Societies paying the PLATFORM a monthly fee. Deliberately a separate entity
// from `Invoice` (Phase 2), which is residents paying their society via
// Safepay — different payer, different recipient; never merge them.
enum PlatformInvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

model PlatformInvoice {
  id          String               @id @default(uuid())
  societyId   String
  society     Society              @relation(fields: [societyId], references: [id])
  // Billing period marker "YYYY-MM". Unique per society — running the monthly
  // job twice must never generate two invoices for the same period.
  billingPeriod String
  // Active unit count at generation time — stored, never recomputed later.
  unitCountSnapshot Int
  // Progressive calculation breakdown (band label, units, rate, subtotal) so
  // the admin view can show exactly how the total was produced.
  calculationBreakdown Json
  // Total in paisa (rupees × 100) — same convention as Invoice.amount.
  totalAmountPaisa  Int
  dueDate     DateTime
  status      PlatformInvoiceStatus @default(PENDING)
  generatedAt DateTime             @default(now())
  paidAt      DateTime?
  // Set by the Super Admin "Mark as Paid" action — the ONLY way an invoice
  // becomes PAID (no self-service button for Committee Admins).
  markedPaidBySuperAdminUserId String?
  markedPaidBySuperAdmin       User?  @relation("PlatformInvoiceMarkedPaidBy", fields: [markedPaidBySuperAdminUserId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  @@unique([societyId, billingPeriod], name: "unique_platform_billing_period")
  @@index([societyId, status])
  @@index([status, dueDate])
}

// A society over the 500-unit auto-invoice cap (ADR 006) is never invoiced by
// the formula — it is flagged once per period for a manual custom-quote
// conversation instead.
model PlatformCustomQuoteFlag {
  id          String   @id @default(uuid())
  societyId   String
  society     Society  @relation(fields: [societyId], references: [id])
  billingPeriod String // period in which the flag was raised ("YYYY-MM")
  unitCountSnapshot Int
  note        String?
  resolvedAt  DateTime? // set once a Super Admin handles the quote
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@unique([societyId, billingPeriod], name: "unique_platform_quote_flag_period")
  @@index([societyId])
}
