# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Use 'postgres' when running in Docker,
# 'localhost' for direct host connections.
DATABASE_URL="postgresql://postgres:password@postgres:5432/apartment_management?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis connection string. Use 'redis' when running in Docker,
# 'localhost' for direct host connections.
REDIS_URL="redis://redis:6379"

# ─── Scheduled jobs (cron, optional) ──────────────────────────────────────
# All jobs are disabled gracefully when Redis is unreachable; admin manual
# triggers keep working. Defaults shown.
# DUE_REMINDER_CRON="0 9 * * *"           # daily dues reminders (Phase 7)
# RECURRING_BILLING_CRON="0 8 1 * *"      # monthly resident invoice generation (Phase 8)
# PLATFORM_BILLING_CRON="0 8 1 * *"       # monthly platform invoice generation (Phase 9)
# PLATFORM_OVERDUE_CRON="0 9 * * *"       # daily platform overdue check (Phase 9)

# ─── JWT ────────────────────────────────────────────────────────────────────
# Secret keys for signing JWT tokens. Change these in production!
JWT_ACCESS_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-me-to-a-different-random-64-char-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Google Sign-In ────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client ID at Google Cloud Console →
# https://console.cloud.google.com/apis/credentials → "Create credentials" →
# "OAuth client ID" → application type "Web application".
# Authorized JavaScript origins: http://localhost:3000 (and your production origin)
# GOOGLE_CLIENT_ID  = the client ID (ends in .apps.googleusercontent.com) - the
#                     backend uses it as the audience when verifying ID tokens
# GOOGLE_CLIENT_SECRET = the client secret (only needed if a server-side OAuth
#                     flow is added later; ID-token verification does not use it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
# Public URL of the frontend app. Used to build links that go into emails
# (password reset, and the vendor "magic link" → <FRONTEND_URL>/vendor/ticket/<token>).
# On Render set this to the deployed frontend URL, e.g. https://your-app.vercel.app
FRONTEND_URL="http://localhost:3000"
# Public URL of THIS backend. Ticket photos are served from the backend and email
# clients cannot resolve relative paths, so vendor assignment emails need this to
# point at the publicly reachable API (on Render: https://your-api.onrender.com).
API_PUBLIC_URL="http://localhost:4000"

# ─── Safepay (Payment Gateway - Phase 7 completion) ────────────────────────
# Get credentials from the Safepay dashboard (https://getsafepay.pk/dashboard),
# sandbox credentials from the Safepay Sandbox dashboard.
# SAFEPAY_PUBLIC_KEY  = Merchant API key (starts with "sec_") - shown in Dashboard
# SAFEPAY_PRIVATE_KEY = Merchant secret key - shown in Dashboard
# SAFEPAY_ENV         = sandbox (testing) | production (live) - a config change only
# SAFEPAY_WEBHOOK_SECRET = Shared webhook secret - Dashboard → Developer → Endpoints → "Show shared secret"
SAFEPAY_PUBLIC_KEY=""
SAFEPAY_PRIVATE_KEY=""
SAFEPAY_ENV="sandbox"
SAFEPAY_WEBHOOK_SECRET=""

# ─── Cloudinary (Phase 1) ──────────────────────────────────────────────────
# Get credentials from https://cloudinary.com/console
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Email Provider (Nodemailer over Gmail SMTP - password reset + notifications)
# Per ADR 004, email is sent through the EmailProvider abstraction using the
# developer's Gmail account. Get an App Password (NOT the normal account
# password) from Google Account → Security → 2-Step Verification → App
# passwords: https://myaccount.google.com/apppasswords
# GMAIL_USER           = the sending Gmail address (also used as the From address)
# GMAIL_APP_PASSWORD   = the 16-character App Password Google generates
# Used for: password reset emails, and vendor ticket assignment emails
# (the vendor's no-login "magic link" to update their assigned ticket).
# (Known limitation, accepted for now: Gmail caps sending at ~500 emails/day -
#  see ADR 004 for when to revisit this.)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# How long a password reset link stays valid, in minutes (default 45).
PASSWORD_RESET_TOKEN_TTL_MINUTES=45


SAFEPAY_PUBLIC_KEY= """
SAFEPAY_PRIVATE_KEY= ""
SAFEPAY_ENV=sandbox