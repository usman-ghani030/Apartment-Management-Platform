# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Use 'postgres' when running in Docker,
# 'localhost' for direct host connections.
DATABASE_URL="postgresql://postgres:password@postgres:5432/apartment_management?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis connection string. Use 'redis' when running in Docker,
# 'localhost' for direct host connections.
REDIS_URL="redis://redis:6379"

# ─── JWT ────────────────────────────────────────────────────────────────────
# Secret keys for signing JWT tokens. Change these in production!
JWT_ACCESS_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-me-to-a-different-random-64-char-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Google Sign-In ────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client ID at Google Cloud Console →
# https://console.cloud.google.com/apis/credentials → "Create credentials" →
# "OAuth client ID" → application type "Web application".
# Authorized JavaScript origins: http://localhost:3000 (and your production origin)
# GOOGLE_CLIENT_ID  = the client ID (ends in .apps.googleusercontent.com) — the
#                     backend uses it as the audience when verifying ID tokens
# GOOGLE_CLIENT_SECRET = the client secret (only needed if a server-side OAuth
#                     flow is added later; ID-token verification does not use it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:3000"

# ─── Safepay (Payment Gateway — Phase 7 completion) ────────────────────────
# Get credentials from the Safepay dashboard (https://getsafepay.pk/dashboard),
# sandbox credentials from the Safepay Sandbox dashboard.
# SAFEPAY_PUBLIC_KEY  = Merchant API key (starts with "sec_") — shown in Dashboard
# SAFEPAY_PRIVATE_KEY = Merchant secret key — shown in Dashboard
# SAFEPAY_ENV         = sandbox (testing) | production (live) — a config change only
# SAFEPAY_WEBHOOK_SECRET = Shared webhook secret — Dashboard → Developer → Endpoints → "Show shared secret"
SAFEPAY_PUBLIC_KEY=""
SAFEPAY_PRIVATE_KEY=""
SAFEPAY_ENV="sandbox"
SAFEPAY_WEBHOOK_SECRET=""

# ─── Cloudinary (Phase 1) ──────────────────────────────────────────────────
# Get credentials from https://cloudinary.com/console
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Email Provider (Resend — password reset + notifications) ───────────────
# Get an API key from the Resend dashboard (https://resend.com/api-keys).
# RESEND_API_KEY = the "re_..." API key.
# For local testing without a verified sending domain, Resend's test sandbox
# lets you send to your own account email only — set EMAIL_FROM to
# "OmniHome <onboarding@resend.dev>" and send to the inbox you signed up with.
RESEND_API_KEY=""
# From address. Must be on a domain verified in Resend (or onboarding@resend.dev
# for sandbox testing).
EMAIL_FROM="noreply@luxesociety.com"
# How long a password reset link stays valid, in minutes (default 60).
PASSWORD_RESET_TOKEN_TTL_MINUTES=60


SAFEPAY_PUBLIC_KEY= """
SAFEPAY_PRIVATE_KEY= ""
SAFEPAY_ENV=sandbox