# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Use 'postgres' when running in Docker,
# 'localhost' for direct host connections.
DATABASE_URL="postgresql://postgres:password@postgres:5432/apartment_management?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis connection string. Use 'redis' when running in Docker,
# 'localhost' for direct host connections.
REDIS_URL="redis://redis:6379"

# ─── JWT ────────────────────────────────────────────────────────────────────
# Secret keys for signing JWT tokens. Change these in production!
JWT_ACCESS_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-me-to-a-different-random-64-char-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:3000"

# ─── Cloudinary (Phase 1) ──────────────────────────────────────────────────
# Get credentials from https://cloudinary.com/console
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Email Provider (Phase 1) ──────────────────────────────────────────────
EMAIL_FROM="noreply@luxesociety.com"
